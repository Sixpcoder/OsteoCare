<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppSeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_track</item>
        <item name="android:thumb">@drawable/seekbar_thumb</item>
        <item name="android:maxHeight">6dp</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:splitTrack">false</item>
        <item name="android:max">10</item>
    </style>

    <style name="ToggleButtonSelected">
        <item name="android:background">@drawable/bg_toggle_selected</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ToggleButtonUnselected" parent="ToggleButtonSelected">
        <item name="android:background">@drawable/bg_toggle_unselected</item>
        <item name="android:textColor">@color/primary_blue</item>
        
    </style>
</resources>